{{page-title "Categorias"}}
<center>
    <h1>Categorias</h1>
</center>
<ul>
    {{#each @model as |categoria|}}
    <li>
        ({{categoria.id}}) {{categoria.nombre}}
    </li>
    {{/each}}

    <li>
        <LinkTo @route="categorias.nuevo">Agregar una nueva categoria</LinkTo>
    </li>
</ul>
{{outlet}}