{{#if @model}}
    {{page-title @model.nombre}}
    <h2>{{@model.nombre}}</h2>
    <p>Cantidad: {{@model.cantidad}}</p>
    <p>Precio: {{@model.precio}}</p>
    {{#each @model.categoria as |categoria|}}
        <li>{{categoria.nombre}}</li>
    {{else}}
        <li>Sin categoria</li>
    {{/each}}
{{else}}
    <p>Producto no encontrado</p>
{{/if}}