{{page-title "Nuevo producto"}}
<h2>Nuevo Producto</h2>
<form {{on "submit" this.guardar}}>
    <div>
        <label for="nombre">Nombre</label>
        <Input id="nombre" @value={{this.nombre}} required />
    </div>

    <div>
        <label for="precio">Precio</label>
        <Input id="precio" @type="number" @value={{this.precio}} min="0" step="0.01" required />
    </div>

    <div>
        <label for="cantidad">Cantidad</label>
        <Input id="cantidad" @type="number" @value={{this.cantidad}} min="0" step="1" required/>
    </div>

    <select id="categoria" required {{on "change" this.seleccionarCategoria}}>
        <option value="">Selecciona una categoria</option>

        {{#each @model as |categoria|}}
        <option value={{categoria.id}}>
            {{categoria.nombre}}
        </option>
        {{/each}}
    </select>

    {{#if this.error}}
        <p role="alert">{{this.error}}</p>
    {{/if}}

    <button type="submit" disabled={{this.guardando}}>
        {{if this.guardando "Guardando..." "Guardar"}}
    </button>
</form>