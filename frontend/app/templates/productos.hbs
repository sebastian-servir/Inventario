{{page-title "Productos"}}
<center>
    <h1>Productos</h1>
</center>

<ul>
    {{#each @model as |producto|}}
    
    <li>
        <LinkTo @route="productos.producto" @model={{producto.id}}>
            {{producto.nombre}}
        </LinkTo>
    </li>
    {{else}}
    <li>No hay productos</li>
    {{/each}}
</ul>
{{outlet}}